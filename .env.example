# Copy to .env for docker-compose local runs. Never commit a real .env file.
# No API keys belong here — Azure OpenAI auth uses DefaultAzureCredential /
# Managed Identity in every environment above local dev. Local dev uses
# `dotnet user-secrets` (see README.md), not this file, for anything secret-shaped.

# Azure OpenAI resource (endpoint only — no key)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Set to "true" to use the in-repo fake IChatClient instead of calling Azure OpenAI
USE_FAKE_CHAT_CLIENT=true

# Qdrant (docker-compose service name/port; no credentials in local dev)
QDRANT_URL=http://localhost:6333

# Mock OIDC provider (docker-compose service; simulates Entra ID claim shapes)
OIDC_AUTHORITY=http://localhost:8080
OIDC_AUDIENCE=contoso-hr-assistant

# Azure AI Content Safety (endpoint only — no key; local dev can stub this out)
CONTENT_SAFETY_ENDPOINT=https://your-content-safety-resource.cognitiveservices.azure.com/

# Per-user monthly token budget (R7) — a hard cap enforced before every provider call
MONTHLY_TOKEN_CAP=200000
